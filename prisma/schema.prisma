generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id      String  @id @default(uuid())
  name    String
  email   String  @unique
  phone   String?
  cnpj    String? // CNPJ/CPF do cliente (dados cadastrais do admin)
  address String? // endereço fiscal/comercial
  active  Boolean @default(true)

  // SaaS Subscription
  planId             String?
  plan               Plan?     @relation(fields: [planId], references: [id])
  subscriptionStatus String    @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELED
  trialEnd           DateTime?
  acceptedTermsAt    DateTime? // aceite de Termos/Privacidade no signup (LGPD)
  mercadoPagoId      String?
  cardLast4          String?
  nextBillingDate    DateTime?

  // Stripe (assinatura recorrente com trial)
  stripeCustomerId     String?
  stripeSubscriptionId String?

  financialRecords FinancialRecord[]
  invoices         Invoice[]

  // Customization
  webChatUrl         String?
  openAiKey          String?
  systemPrompt       String?
  googleRefreshToken String?
  aiProvider         String? @default("GEMINI")
  aiApiKey           String?
  elevenLabsKey      String?

  // Perfil do Negócio (contexto do agente de IA)
  businessType      String? // CLINIC, BEAUTY, FITNESS, SERVICES, RESTAURANT, OTHER
  businessAbout     String? // descrição/apresentação do negócio
  businessAddress   String? // endereço completo
  businessPayment   String? // formas de pagamento aceitas
  businessExtraInfo String? // estacionamento, acessibilidade, orientações gerais
  labelOverrides    String? // JSON: rótulos customizados (ex.: {"customer":"Aluno","service":"Aula"})

  // Consumption Tracking (Real-time)
  usedTokens           Int      @default(0)
  extraTokens          Int      @default(0) // saldo de tokens comprados (recarga), consumido após a franquia do plano
  usedMessages         Int      @default(0)
  usedCampaignMessages Int      @default(0) // disparos em massa no ciclo atual
  qualifiedLeadsCount  Int      @default(0)
  lastUsageReset       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  leads            Lead[]
  automationConfig AutomationConfig?
  automations      Automation[]
  sdrs             SdrBot[]
  appointments     Appointment[]
  whatsappAccounts WhatsAppAccount[]
  waitlists        Waitlist[]
  prospectionLogs  ProspectionLog[]

  // Custom Pipelines
  pipelineStages PipelineStage[]

  // Marketing / Bulk Messaging
  campaigns Campaign[]
  templates MessageTemplate[]

  conversations Conversation[]
  messages      Message[]
  products      Product[]
  icpProfiles   IcpProfile[]

  // Base de conhecimento estruturada do negócio
  teamMembers    TeamMember[]
  services       Service[]
  paymentMethods PaymentMethod[]
  businessHours  BusinessHour[]
  faqs           Faq[]
  serviceQueues  ServiceQueue[]

  // CDP e integrações
  contactIdentities ContactIdentity[]
  apiKeys           ApiKey[]
  crmConnections    CrmConnection[]
}

model PipelineStage {
  id    String  @id @default(uuid())
  name  String // Ex: Novos, Qualificando, Agendados
  color String? @default("#3b82f6")
  order Int     @default(0)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  leads Lead[]
}

model Tag {
  id    String  @id @default(uuid())
  name  String
  color String? @default("#cbd5e1")

  // Many-to-many relationship with Leads is better but SQLite doesn't support implicit join tables easily for large scale. 
  // I'll use a string of tag IDs in Lead for now as a common pattern for SQLite portability, or a explicit join model.
  // Actually, standard Many-to-Many is fine.
  leads Lead[]
}

model Lead {
  id    String  @id @default(uuid())
  name  String
  phone String?
  email String?

  // Reference to PipelineStage
  status  String         @default("NEW")
  stageId String?
  stage   PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  source   String?
  tags     Tag[] // Many-to-Many
  notes    String?
  tenantId String

  // Canal de origem da conversa e a conexão (WhatsAppAccount.id) que a recebeu.
  // Permite agrupar/filtrar o inbox por canal e por número/conta conectada.
  channel     String  @default("WHATSAPP") // WHATSAPP | INSTAGRAM | SITE
  waAccountId String?

  // Identificador do contato NO CANAL: IGSID do Instagram, id de visitante do
  // site, LID do WhatsApp. Antes tudo isso era gravado em `phone`, que passou a
  // guardar só telefone de verdade.
  externalId String?
  igUsername String? // @usuario do Instagram

  // Contatos e canais adicionais (preenchidos pelo BDR)
  website     String?
  socialLinks String? // JSON: { linkedin, instagram, facebook, ... }
  extraPhones String? // JSON ou Texto: fone1, fone2...
  extraEmails String? // JSON ou Texto: email1, email2...

  isToEnrich Boolean @default(false)

  // LGPD / Consentimento
  optedOut  Boolean   @default(false) // titular pediu para parar (stop-keyword)
  optOutAt  DateTime?
  consentAt DateTime? // registro de opt-in (primeira interação/consentimento)

  // Fase 3 — IA Avançada
  qualificationScore       Int? // 0-100 score via IA
  extractedData            String? // JSON com dados extraídos via NER (nome, empresa, cargo, etc.)
  lastIntentClassification String? // Última intent classificada pela IA

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations        Conversation[]
  appointments         Appointment[]
  progressions         AutomationProgress[]
  automationExecutions AutomationExecution[]
  waitlists            Waitlist[]
  identities           ContactIdentity[]

  /// Quantas vezes este contato absorveu duplicatas. Serve de rastro para
  /// entender a base depois de uma importação suja.
  mergedCount Int @default(0)

  @@unique([phone, tenantId])
  @@index([tenantId, channel, externalId])
  @@index([tenantId, email])
}

/// Chave de identidade do contato (CDP).
///
/// Um contato é a MESMA pessoa em vários canais: WhatsApp, Instagram, o
/// formulário do site, o CRM. Guardar isso só em `Lead.phone` duplicava a
/// base — cada canal chegava com um identificador diferente e virava um
/// contato novo. Aqui cada identificador conhecido aponta para um único
/// contato, e a unicidade por (tenant, tipo, valor) é o que impede a
/// duplicata no banco, não só no código.
model ContactIdentity {
  id       String @id @default(uuid())
  tenantId String
  leadId   String

  /// PHONE | EMAIL | WHATSAPP | INSTAGRAM | SITE | CPF | CRM | EXTERNAL
  type     String
  /// Valor normalizado — é ele que dedupe. Telefone vira E.164 sem "+".
  value    String
  /// Como o valor chegou, para auditoria ("(71) 98888-7777").
  rawValue String?
  /// Quem trouxe este identificador: canal, importação, provedor de CRM.
  source   String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, value])
  @@index([leadId])
}

/// Chave de API do cliente, para o CRM dele falar com a plataforma.
model ApiKey {
  id       String @id @default(uuid())
  tenantId String
  name     String

  /// Primeiros caracteres, mostrados na tela ("av_live_a1b2…").
  prefix String
  /// Só o hash é guardado: a chave inteira aparece uma vez, na criação.
  hash   String @unique

  scopes     String    @default("contacts:read,contacts:write")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Conexão com um CRM externo (RD Station, HubSpot, Salesforce, Pipedrive).
model CrmConnection {
  id       String @id @default(uuid())
  tenantId String

  /// RDSTATION | HUBSPOT | SALESFORCE | PIPEDRIVE
  provider String
  name     String?

  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  /// Extras do provedor (instanceUrl do Salesforce, domínio, etc.).
  config       String?

  /// IN = só puxa do CRM, OUT = só envia, BOTH = os dois.
  direction String  @default("BOTH")
  active    Boolean @default(true)

  /// Mapa de campos personalizados, em JSON.
  fieldMap String?

  lastSyncAt  DateTime?
  lastStatus  String?
  lastError   String?
  syncedCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs   CrmSyncLog[]

  @@unique([tenantId, provider])
}

/// Histórico de sincronização, para o cliente ver o que entrou e o que falhou.
model CrmSyncLog {
  id           String @id @default(uuid())
  connectionId String

  /// IN | OUT
  direction  String
  /// OK | ERROR
  status     String
  leadId     String?
  externalId String?
  message    String?

  createdAt DateTime @default(now())

  connection CrmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
}

model Campaign {
  id          String    @id @default(uuid())
  name        String
  channel     String    @default("WHATSAPP") // WHATSAPP, EMAIL
  status      String    @default("DRAFT") // DRAFT, RUNNING, COMPLETED, PAUSED
  scheduledAt DateTime?

  templateId String
  template   MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  targetTagIds  String? // IDs das tags participantes (JSON string)
  targetLeadIds String? // seleção explícita de contatos (JSON array de Lead.id)

  // Conexão que dispara e projeção congelada na criação — a tarifa pode
  // mudar depois, e o histórico precisa refletir o que foi cobrado.
  accountId      String?
  recipientCount Int       @default(0)
  estimatedCost  Float     @default(0) // preço em BRL projetado (o que o cliente paga)
  /// Custo real projetado — o que a Meta cobra, sem a margem. Guardado junto
  /// para o relatório do SaaS mostrar a margem de verdade de cada disparo.
  realCost       Float     @default(0)
  variables      String? // JSON: valores fixos dos {{n}} do template
  errorLog       String? // últimos erros do disparo, para diagnóstico
  startedAt      DateTime?
  finishedAt     DateTime?

  sentCount      Int @default(0)
  deliveredCount Int @default(0)
  readCount      Int @default(0)
  clicks         Int @default(0)
  errorCount     Int @default(0)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  recipients CampaignRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Um registro por destinatário de campanha. Sem isso o disparo só tinha
/// contadores agregados, e não havia como dizer QUEM recebeu e quem falhou.
model CampaignRecipient {
  id         String  @id @default(uuid())
  campaignId String
  leadId     String?

  // Nome e telefone congelados no momento do envio: o contato pode mudar
  // depois, e o relatório precisa refletir o que foi usado.
  name  String?
  phone String

  status    String    @default("PENDING") // PENDING | SENT | FAILED
  error     String?
  messageId String? // wamid, para cruzar com os webhooks de status
  sentAt    DateTime?

  createdAt DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
}

model MessageTemplate {
  id       String  @id @default(uuid())
  name     String
  content  String // Texto do corpo, com {{1}}, {{2}}… (placeholders da Meta)
  mediaUrl String? // Imagem/Vídeo do cabeçalho
  buttons  String? // JSON string dos botões

  // Sincronia com a Meta. O template vive na WABA, não no número: accountId
  // guarda a conexão usada para sincronizar (de onde saem wabaId e token).
  // Só status APPROVED pode ser disparado.
  accountId      String?
  metaId         String? // id na Meta; nulo enquanto for rascunho local
  language       String    @default("pt_BR")
  category       String    @default("UTILITY") // MARKETING | UTILITY | AUTHENTICATION
  status         String    @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED | PAUSED
  headerType     String? // TEXT | IMAGE | VIDEO | DOCUMENT
  headerText     String?
  footerText     String?
  rejectedReason String?
  lastSyncedAt   DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name, language])
  @@index([tenantId, status])
}

model Plan {
  id           String @id @default(uuid())
  name         String // Starter, Pro, Enterprise
  priceMonthly Float
  priceYearly  Float

  // Hard Limits (aplicados no acesso ao recurso)
  maxLeads              Int @default(500)
  maxSdrs               Int @default(1)
  maxUsers              Int @default(2) // usuários na equipe
  maxWhatsAppNumbers    Int @default(1) // números conectados
  maxCampaignMessages   Int @default(0) // disparos em massa/mês; 0 = recurso desligado
  maxKnowledgeBaseChars Int @default(50000) // tamanho do treino do agente

  // Usage Credits (renovam por mês)
  maxTokens   Int @default(100000)
  maxMessages Int @default(1000)

  // Feature toggles — ligam/desligam módulos inteiros
  enableSdr          Boolean @default(true)
  enableTokens       Boolean @default(true)
  enableMessages     Boolean @default(true)
  enableCalendar     Boolean @default(true) // Google Calendar
  enableAutomations  Boolean @default(true) // Lembretes/no-show
  enableWebhooks     Boolean @default(false) // API pública/webhooks
  enableVoice        Boolean @default(false) // agente ouve (STT) e responde (TTS) em áudio
  enablePremiumVoice Boolean @default(false) // libera as vozes premium (ElevenLabs)

  /// Categoria de referência da franquia de disparos. A Meta cobra tarifas
  /// diferentes por categoria, então o custo do plano só fecha quando se sabe
  /// que tipo de disparo ele inclui. MARKETING é a mais cara — é o padrão
  /// para o plano nunca ser vendido abaixo do custo.
  campaignCategory String @default("MARKETING")

  // Custos operacionais unitários (para cálculo de margem no admin)
  sdrUnitCost     Float @default(15.0)
  tokenUnitCost   Float @default(0.08)
  messageUnitCost Float @default(0.05)

  features String? // JSON — extras futuros (RAG, integrações específicas, etc.)
  active   Boolean @default(true)

  // Stripe: Price recorrente (criado sob demanda a partir de name/priceMonthly)
  stripePriceId String?

  tenants   Tenant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SdrBot {
  id   String @id @default(uuid())
  name String
  role String @default("INBOUND") // INBOUND, OUTBOUND

  // Função do agente (preset de persona + skills). Ver AgentFunctions.js.
  agentFunction String  @default("SCHEDULER") // SDR, SELLER, SUPPORT, SCHEDULER, CONSULTANT
  skills        String? // JSON array de skills habilitadas (ex.: ["schedule","send_catalog"])

  prompt String? @default("Você é um SDR focado em qualificar leads.")

  // Áudio e Voz (ElevenLabs)
  voiceId      String? @default("21m00Tcm4TlvDq8ikWAM") // ID da voz (Default: Rachel)
  responseMode String  @default("TEXT") // TEXT, AUDIO, BOTH

  // Treinamento individualizado (Requisito 4 e 5)
  knowledgeBase String? @default("") // Texto de treinamento
  trainingUrls  String? // Links de sites ou arquivos (JSON array string)

  // Parâmetros avançados de IA (Requisito 8 e 9)
  responseDelay      Int     @default(2000) // Milisegundos
  voiceTone          String  @default("PROFESSIONAL") // CASUAL, PROFESSIONAL, PERSUASIVE
  escalationKeywords String? @default("atendente, falar com humano, ajuda, queima, dor, bolha")

  // Parâmetros Globais de Negócio (Extraídos dos áudios)
  followUpInterval      Int     @default(120) // Minutos para cobrar resposta após preço
  preConfirmationHours  Int     @default(12) // Horas antes para pré-confirmação
  noShowGraceMinutes    Int     @default(15) // Minutos de tolerância antes de cobrar presença
  postServiceCheckHours Int     @default(24) // Horas após serviço para enviar pós-venda
  enableWaitlist        Boolean @default(true) // Encaixe automático em desistências

  // Conexões que este agente atende (JSON array de WhatsAppAccount.id).
  // Vazio/nulo = atende todas as conexões da conta, que é o comportamento
  // de quem só tem um número.
  accountIds String?

  tenantId String
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AutomationConfig {
  id               String @id @default(uuid())
  // Parâmetros Globais de Negócio (Extraídos dos áudios)
  autoConfirmHours Int    @default(24)
  lateToleranceMin Int    @default(15)
  postServiceHours Int    @default(24)
  humanHandoffTags String @default("ajuda, atendente, humano, queima, dor, bolha")

  // Estrutura Visual (Opcional se usado como Hub Global)
  nodes String? // JSON string
  edges String? // JSON string

  // Templates de Mensagens (Universalização)
  confirmMsgTemplate     String? @default("Olá {name}! 👋 Passando para confirmar seu atendimento de amanhã às {time}. Podemos confirmar? ✅")
  lateMsgTemplate        String? @default("Oi {name}! 😊 Notamos que você ainda não chegou para o seu horário das {time}. Está tudo bem?")
  postServiceMsgTemplate String? @default("Oi {name}! Esperamos que tenha gostado do atendimento! ✨ Como foi sua experiência?")

  // Régua do agendamento: cada momento pode ser ligado/desligado sozinho.
  remindersEnabled    Boolean @default(true)
  bookedEnabled       Boolean @default(true)
  confirmEnabled      Boolean @default(true)
  meetLinkEnabled     Boolean @default(true)
  finalEnabled        Boolean @default(true)
  noShowEnabled       Boolean @default(true)
  postServiceEnabled  Boolean @default(true)
  pipelineAutoEnabled Boolean @default(true)

  meetLinkMinutes   Int     @default(10)
  // Template aprovado usado quando a janela de 24h já fechou.
  confirmTemplateId String?
  bookedMsgTemplate String?
  meetMsgTemplate   String?
  finalMsgTemplate  String?
  // JSON { evento: nome da etapa } para mover o lead no funil.
  stageMap          String?

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Automation {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String?

  // Trigger config
  trigger       String // NEW_LEAD, NEW_MSG, KEYWORD, PIPELINE_MOVE, INACTIVITY, APPOINTMENT_CREATED, SCHEDULE
  triggerConfig String? // JSON: { keywords: [], inactivityMinutes: 1440, schedule: "0 9 * * *" }

  // Flow Definition (ReactFlow format)
  nodes String? // JSON: [{ id, type, position: {x,y}, data: { label, config } }]
  edges String? // JSON: [{ id, source, target, sourceHandle }]

  active  Boolean @default(true)
  version Int     @default(1)

  // Stats
  totalExecutions Int       @default(0)
  lastExecutedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]
  progressions AutomationProgress[]
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  phone    String? // WhatsApp do admin para Modo Comando
  role     String  @default("ADMIN") // ADMIN, AGENT, OWNER, SUPERADMIN
  tenantId String

  // Verificação de e-mail
  emailVerified              Boolean   @default(false)
  emailVerificationToken     String?   @unique
  emailVerificationExpiresAt DateTime?

  // Reset de senha
  passwordResetToken     String?   @unique
  passwordResetExpiresAt DateTime?

  // 2FA (TOTP)
  twoFactorEnabled     Boolean @default(false)
  twoFactorSecret      String? // segredo base32
  twoFactorBackupCodes String? // JSON com códigos de recuperação já usados/pendentes

  lastLoginAt DateTime?

  // Acesso do colaborador. `active=false` bloqueia o login sem apagar o
  // histórico; `permissions` guarda os módulos liberados pelo admin (JSON),
  // e nulo significa "o que o perfil da função dá".
  active        Boolean   @default(true)
  deactivatedAt DateTime?
  permissions   String?
  jobTitle      String?

  queueMemberships      QueueMember[]
  assignedConversations Conversation[] @relation("ConversationAssignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String  @id @default(uuid())
  leadId    String  @unique
  tenantId  String
  botActive Boolean @default(true)

  // Fase do atendimento. BOT = agente de IA respondendo; QUEUE = na fila
  // esperando um humano; HUMAN = atendente conduzindo; CLOSED = encerrada.
  phase         String    @default("BOT")
  queueId       String?
  queuedAt      DateTime?
  handoffReason String?
  assignedToId  String?
  assignedAt    DateTime?
  closedAt      DateTime?
  closedById    String?

  // Ordenação e não-lidas do inbox. lastMessageAt existe separado de
  // updatedAt porque updatedAt muda a cada toggle do bot, o que reordenaria
  // a lista sem mensagem nova.
  lastMessageAt      DateTime?
  lastMessagePreview String? // trecho da última mensagem, p/ a lista
  unreadCount        Int       @default(0)

  // Última mensagem RECEBIDA do cliente: define a janela de 24h da Meta,
  // fora da qual só é possível iniciar conversa por template aprovado.
  lastInboundAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead       Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages   Message[]
  queue      ServiceQueue?       @relation(fields: [queueId], references: [id], onDelete: SetNull)
  assignedTo User?               @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  events     ConversationEvent[]

  @@index([tenantId, lastMessageAt])
  @@index([tenantId, phase, queuedAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  tenantId       String
  content        String
  role           String
  messageType    String   @default("TEXT")
  mediaUrl       String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Appointment {
  id            String    @id @default(uuid())
  leadId        String
  tenantId      String
  title         String
  date          DateTime
  status        String    @default("SCHEDULED")
  notes         String?
  // Evento no Google e link do Meet, para o lembrete de 10 minutos antes.
  googleEventId String?
  meetLink      String?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lead      Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reminders AppointmentReminder[]
}

// Um registro por momento da régua do agendamento (agradecimento, confirmação
// 24h antes, link da call, lembrete final, no-show, pós-atendimento).
//
// Guardar cada envio como linha — em vez de flags dentro de Appointment.notes —
// é o que permite saber o que ainda vai sair, o que falhou e por quê, além de
// tornar o disparo idempotente mesmo com o processo reiniciando.
model AppointmentReminder {
  id            String    @id @default(uuid())
  appointmentId String
  tenantId      String
  kind          String // BOOKED | CONFIRM | MEET_LINK | FINAL | NOSHOW | POST_SERVICE
  runAt         DateTime
  status        String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED | CANCELLED
  attempts      Int       @default(0)
  sentAt        DateTime?
  channel       String?
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, kind])
  @@index([status, runAt])
}

model AutomationProgress {
  id            String    @id @default(uuid())
  automationId  String
  leadId        String
  currentStepId String?
  status        String    @default("RUNNING")
  nextRun       DateTime?
  data          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([automationId, leadId])
}

model AutomationExecution {
  id           String @id @default(uuid())
  automationId String
  leadId       String

  status        String  @default("RUNNING") // RUNNING, WAITING_INPUT, WAITING_DELAY, COMPLETED, FAILED, CANCELLED
  currentNodeId String?

  // Flow context (variables persisted between steps)
  context String? // JSON: { variables: {}, inputs: {}, metadata: {} }

  // Delay/scheduling
  resumeAt DateTime?

  // User input collection
  waitingForInput Boolean @default(false)
  inputVariable   String? // variable name to save user response into

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  error       String?

  automation Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  lead       Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  steps      AutomationStepLog[]
}

model AutomationStepLog {
  id          String @id @default(uuid())
  executionId String
  nodeId      String
  nodeType    String

  status   String  @default("SUCCESS") // SUCCESS, FAILED, SKIPPED
  input    String? // JSON: node config/data
  output   String? // JSON: result of execution
  duration Int? // ms

  createdAt DateTime @default(now())

  execution AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

// Conta de canal de atendimento. Apesar do nome histórico, suporta
// WhatsApp e Instagram Direct (ambos via infra Meta).
model WhatsAppAccount {
  id      String  @id @default(uuid())
  name    String
  phone   String?
  status  String  @default("DISCONNECTED")
  channel String  @default("WHATSAPP") // WHATSAPP | INSTAGRAM
  enabled Boolean @default(true) // desligado = agente ignora mensagens deste canal

  // Meta Cloud API Fields (WhatsApp)
  phoneId     String?
  accessToken String? // WhatsApp: permanent token · Instagram: page access token
  wabaId      String?

  // Instagram Direct (Messenger Platform)
  igId   String? // Instagram Business Account ID (roteia o webhook)
  pageId String? // Facebook Page ID vinculada

  tenantId String

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Configurações globais da plataforma (singleton), editáveis pelo
// SUPERADMIN no portal. Valores do banco têm precedência; env é fallback.
model PlatformSettings {
  id              String @id @default("singleton")
  // Gateway ativo: "MERCADO_PAGO" ou "STRIPE"
  paymentProvider String @default("MERCADO_PAGO")

  // Mercado Pago
  mpAccessToken        String? // access token
  paymentWebhookSecret String? // segredo HMAC do webhook MP

  // Stripe
  stripeSecretKey      String? // sk_live_… / sk_test_…
  stripeWebhookSecret  String? // whsec_… (assinatura do webhook Stripe)
  stripePublishableKey String? // pk_live_… / pk_test_… (exposta ao checkout)

  // ─── Motor de IA (configurável no painel admin) ───
  // Provedor ativo do agente: "GEMINI" | "OPENAI" | "ANTHROPIC"
  aiProvider      String? @default("GEMINI")
  // Modelo escolhido (ex.: "gemini-2.5-flash", "gpt-4o", "claude-opus-4-8")
  aiModel         String?
  // Chaves por provedor (uma para cada família de modelos)
  geminiApiKey    String?
  openaiApiKey    String?
  anthropicApiKey String?

  // ─── Motor de VOZ (também global, definido pelo admin) ───
  // Provedor de TTS: "GEMINI" | "ELEVENLABS"
  voiceProvider    String? @default("GEMINI")
  elevenLabsApiKey String?
  // Tarifas da Meta por mensagem (USD), editáveis pelo admin porque a Meta
  // reajusta sem aviso. JSON: { marketing, utility, authentication }.
  waRates          String?
  waMarkup         Float   @default(2.0) // multiplicador sobre o custo, igual ao dos tokens

  // Vozes LIBERADAS para as contas — JSON: [{ id, name }]. Vazio = todas.
  enabledVoices String?

  // ─── Precificação de tokens (planos e recargas) ───
  // Câmbio USD→BRL usado para converter o preço real dos provedores.
  usdToBrl    Float @default(5.5)
  // Markup padrão de venda sobre o custo (ex.: 5 = vender por 5x o custo).
  tokenMarkup Float @default(5.0)

  defaultTrialDays Int      @default(7)
  updatedAt        DateTime @updatedAt
}

// Pacotes de tokens avulsos (recarga) — definidos pelo admin do SaaS.
model TokenPackage {
  id        String   @id @default(uuid())
  name      String
  tokens    Int // quantos tokens de IA o pacote concede
  price     Float // preço em BRL
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LandingPageSettings {
  id               String  @id @default("singleton")
  logoUrl          String?
  contactWhatsApp  String?
  contactEmail     String?
  contactInstagram String?
  contactLinkedIn  String?
  contactYouTube   String?

  // SDR for Landing Page Chat
  selectedSdrId String?

  // Plans to show (comma separated IDs)
  visiblePlanIds String? @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String  @id @default(uuid())
  name        String
  type        String  @default("PRODUCT") // PRODUCT, SERVICE
  category    String? // agrupamento livre (ex.: "Estética", "Planos")
  description String?
  price       Float?
  size        String? // P, M, G ou dimensões
  buyUrl      String? @default("https://")

  // Mídia que o agente pode enviar durante a conversa.
  imageUrl String?
  audioUrl String?
  videoUrl String?

  isActive Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IcpProfile {
  id   String @id @default(uuid())
  name String // Ex: Donos de Restaurantes em SP

  // Critérios de Busca (Base)
  niche    String? // Ex: Restaurantes, Academias
  role     String? // Ex: CEO, Dono, Gerente Comercial
  location String? // Ex: São Paulo, Brasil

  // Detalhes do Perfil (Contexto para SDR)
  industry    String? // Ex: Tecnologia, Varejo, Saúde
  companySize String? // Ex: 1-10, 11-50, 50-200
  painPoints  String? // Ex: Baixa conversão em anúncios, falta de SDR
  goals       String? // Ex: Aumentar agendamentos, automatizar vendas

  // Configurações de Deep Research (IA Hunter)
  relevantInfo       String? // Informações específicas que a IA deve buscar
  searchKeywords     String? // Palavras-chave adicionais para o buscador
  dailyResearchLimit Int     @default(10) // Limite de pesquisas profundas por dia

  // Automação
  isAutoHunterEnabled Boolean @default(false)
  isProspectingActive Boolean @default(false)
  isActive            Boolean @default(true)
  dailyLimit          Int     @default(200) // Limite de contatos diários

  // Vinculação específica de SDR (Opcional)
  sdrId String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  prospectionLogs ProspectionLog[]
}

model Waitlist {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  priority  Int      @default(0)
  notes     String?
  status    String   @default("PENDING") // PENDING, NOTIFIED, CONVERTED, EXPIRED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProspectionLog {
  id         String      @id @default(uuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  icpId      String?
  icp        IcpProfile? @relation(fields: [icpId], references: [id], onDelete: SetNull)
  query      String
  source     String // Ex: GOOGLE_MAPS, LINKEDIN, APOLLO
  leadsFound Int         @default(0)
  status     String // SUCCESS, FAILED
  error      String?
  createdAt  DateTime    @default(now())
}

model FinancialRecord {
  id          String    @id @default(uuid())
  description String
  amount      Float
  type        String // REVENUE, EXPENSE
  category    String // Ex: Servidor, API OpenAI, Licença, Plano SaaS, etc.
  isRecurring Boolean   @default(false)
  frequency   String? // MONTHLY, YEARLY
  dueDate     DateTime?
  paidAt      DateTime?
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Invoice {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount        Float
  status        String    @default("PENDING") // PENDING, PAID, OVERDUE, CANCELED
  dueDate       DateTime
  paidAt        DateTime?
  // Período de competência (ex.: "2026-07"). Garante idempotência do cron:
  // uma fatura por tenant por período, imposta por constraint no banco.
  billingPeriod String?
  // Id da cobrança/pagamento no gateway; preenchido só pelo webhook.
  gatewayId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, billingPeriod])
}

// Trilha de auditoria mínima: ações sensíveis (billing/admin) para
// rastreabilidade e conformidade (LGPD exige registro de tratamento).
model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String? // tenant afetado (quando aplicável)
  actorId   String? // usuário que executou (null = sistema/webhook)
  action    String // ex.: "INVOICE_PAID", "PLAN_UPDATED", "TENANT_DELETED"
  entity    String? // tipo da entidade afetada
  entityId  String? // id da entidade afetada
  metadata  String? // JSON com detalhes adicionais
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([action])
}

// ═══════════════════════════════════════════════════════════════
// Base de conhecimento estruturada do negócio (contexto do agente)
// Vocabulário genérico servindo qualquer vertical: clínicas, salões,
// academias, restaurantes, serviços profissionais.
// ═══════════════════════════════════════════════════════════════

model TeamMember {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  role        String? // ex.: "Ortodontista", "Cabeleireira", "Personal", "Advogado"
  credentials String? // registro profissional / OAB / CRM / CREF etc.
  bio         String? // breve descrição / diferenciais
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Service {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String?
  durationMin Int     @default(30) // duração média em minutos
  price       Float? // preço (null = sob consulta)
  prep        String? // preparo/observações prévias
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Formas de pagamento/convênios aceitos (opcional por vertical)
model PaymentMethod {
  id       String  @id @default(uuid())
  tenantId String
  name     String // ex.: "Unimed", "PIX", "Cartão", "Vale-Refeição"
  notes    String? // observações (carência, limites, taxas)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model BusinessHour {
  id        String  @id @default(uuid())
  tenantId  String
  weekday   Int // 0=Domingo ... 6=Sábado
  openTime  String? // "09:00"
  closeTime String? // "18:00"
  isClosed  Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, weekday])
}

model Faq {
  id       String @id @default(uuid())
  tenantId String
  question String
  answer   String
  order    Int    @default(0)

  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Fila de atendimento humano. Um tenant pode ter várias (Vendas, Suporte…);
// a conversa entra numa fila quando o agente de IA transfere.
model ServiceQueue {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String?
  color       String? @default("#2563EB")
  order       Int     @default(0)
  active      Boolean @default(true)
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members       QueueMember[]
  conversations Conversation[]

  @@index([tenantId, active])
}

// Quem atende cada fila.
model QueueMember {
  id      String @id @default(uuid())
  queueId String
  userId  String

  createdAt DateTime @default(now())

  queue ServiceQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queueId, userId])
}

// Linha do tempo do atendimento: entrou na fila, foi assumido, transferido,
// devolvido à IA, encerrado. É o que permite auditar e mostrar o histórico
// na conversa sem depender de mensagens de texto.
model ConversationEvent {
  id             String  @id @default(uuid())
  conversationId String
  tenantId       String
  type           String // QUEUED | ASSIGNED | TRANSFERRED | RETURNED_TO_BOT | CLOSED | REOPENED
  fromPhase      String?
  toPhase        String?
  actorUserId    String?
  actorName      String?
  note           String?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
